{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/backend/WhereWeFishin.API/WhereWeFishin.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "watch-backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/backend/WhereWeFishin.API/WhereWeFishin.API.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean-backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/backend/WhereWeFishin.API/WhereWeFishin.API.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Start Python Service",
      "type": "shell",
      "command": "cd fish-recognition-service; .\\venv\\Scripts\\Activate.ps1; python app.py",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "services"
      }
    },
    {
      "label": "Start Backend API",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/backend/WhereWeFishin.API"
      },
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "services"
      }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "ng serve",
      "options": {
        "cwd": "${workspaceFolder}/Frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "services"
      }
    },
    {
      "label": "Start All Services",
      "dependsOn": [
        "Start Python Service",
        "Start Backend API",
        "Start Frontend"
      ],
      "problemMatcher": []
    }
  ]
}
