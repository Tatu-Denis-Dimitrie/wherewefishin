# =============================================
# WhereWeFishin - Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# docker-compose automatically reads .env

# SQL Server SA password (must meet SQL Server complexity requirements)
SQL_SA_PASSWORD=YourStr0ngP@ssw0rd!

# JWT signing key (at least 32 characters)
JWT_KEY=YourSuperSecretKeyThatShouldBeAtLeast32CharactersLongForHS256Algorithm

# Frontend URL (used in password reset emails)
FRONTEND_URL=https://wherewefishin.uk

# Stripe keys for Docker deployment
# Secret key is used by backend to create and validate payments.
STRIPE_SECRET_KEY=sk_test_51T3tmZLbUF11stB2MBlfdXrkJDs40dmH5CcPhaQTKMOtpBVKAZlQ7SEGN4tGtKdIY3Dt1ojOjKnSSSOszmYuzGlD00DiB3OCmv

# Publishable key is injected into Angular production build in Docker.
STRIPE_PUBLISHABLE_KEY=pk_test_51T3tmZLbUF11stB2s4FUN6xMWGAhgT9P9daOS7hFjpB5X4VZldHe5pScprP7D1hJPjL1sM7JVOzsUBhX6rVyqEVt00Ucyq4JYv

# Cloudflare Tunnel token (from Cloudflare Zero Trust dashboard)
# See README for setup instructions
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
