# WhereWeFishin - Fish Recognition Service Configuration

# Video Processing Settings
USE_FFMPEG_REENCODE=true
USE_AV1_CODEC=false

# Model Settings
MODEL_PATH=models/best.pt

# Server Settings
HOST=0.0.0.0
PORT=5001
DEBUG=true

# Upload Settings
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv

# FFmpeg Encoding Settings (when USE_FFMPEG_REENCODE=true)

# H.264 Settings (default)
H264_PRESET=medium        # ultrafast, fast, medium, slow, slower, veryslow
H264_CRF=23              # Quality: 0-51 (lower=better, 18-28 recommended)

# AV1 Settings (if USE_AV1_CODEC=true)
AV1_CRF=30               # Quality: 0-63 (lower=better)
AV1_CPU_USED=8           # Speed: 0-8 (higher=faster but lower quality)

# Notes:
# - H.264 is RECOMMENDED for best browser compatibility
# - AV1 provides better compression but much slower encoding
# - Set USE_FFMPEG_REENCODE=false to skip re-encoding (not recommended for web)
